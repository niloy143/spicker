{
	"manifest_version": 3,
	"name": "Spicker",
	"description": "Extend the statistics of TopTracker",
	"version": "1.0.0",
	"action": {
		"default_popup": "popup.html"
	},
	"permissions": ["cookies"],
	"host_permissions": ["https://tracker.toptal.com/*"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	},
	"content_scripts": [
		{
			"js": ["content.js"],
			"matches": ["https://tracker.toptal.com/*"]
		}
	]
}
