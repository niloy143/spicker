{
	"manifest_version": 3,
	"name": "Spicker",
	"description": "Extend the statistics of TopTracker",
	"version": "1.1.2",
	"action": {
		"default_popup": "popup.html",
		"default_icon": {
			"16": "icons/icon16.png",
			"48": "icons/icon48.png",
			"128": "icons/icon128.png"
		}
	},
	"permissions": ["cookies"],
	"host_permissions": ["https://tracker.toptal.com/*"],
	"icons": {
		"16": "icons/icon16.png",
		"48": "icons/icon48.png",
		"128": "icons/icon128.png"
	}
}
